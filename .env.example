# Copy this file to .env and fill in the values. Never commit .env.

# Which Claude to talk to:
#   claude-code   = your Claude subscription, through the Claude Agent SDK (you must be logged in to Claude Code). Local, personal use only.
#   anthropic-api = the Anthropic API with ANTHROPIC_API_KEY (what a real deployment, or anyone cloning this repo, uses).
AI_PROVIDER=claude-code

# Model for both modes. Sonnet picks tools and explains; the tools do the math. Switch to claude-opus-5-5 if needed.
CLAUDE_MODEL=claude-sonnet-5-5

# Only for AI_PROVIDER=anthropic-api. Create one at https://platform.claude.com
ANTHROPIC_API_KEY=

# Same Supabase project as the dashboard (Project Settings > API Keys).
SUPABASE_URL=
# Publishable key (sb_publishable_...): can only READ demo rows.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): ONLY for approve/reject (after you type y) and npm run seed:recon. Never share it.
SUPABASE_SECRET_KEY=

# Which rows the agent sees: demo (default, is_demo = true, publishable key) | all | real (need the secret key, local only).
DATA_SCOPE=demo

# Approve/reject only works on demo invoices unless this is true (and DATA_SCOPE lets the agent see real rows).
ALLOW_REAL_UPDATES=false

# Folder the reconciliation tools may read statement CSVs from (nothing else on your computer). Default: samples
STATEMENTS_DIR=samples
