{
  "name": "invoice-assistant-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "chat": "node --env-file-if-exists=.env src/chat.ts",
    "tool": "node --env-file-if-exists=.env scripts/tool.ts",
    "seed:recon": "node --env-file-if-exists=.env scripts/seed-recon.ts",
    "eval": "node --env-file-if-exists=.env scripts/eval.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
